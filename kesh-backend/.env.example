# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to GitHub - add ".env" to .gitignore.

DB_USERNAME=postgres
DB_PASSWORD=postgres

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free key from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Free key from https://newsapi.org/register
NEWSAPI_API_KEY=

# REQUIRED for auth. Any long random string works — generate one with:
# openssl rand -base64 32
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this backend.
# For local dev the default already covers localhost:5173/3000 — only set
# this for production, e.g.:
# CORS_ALLOWED_ORIGINS=https://kesh.vercel.app
CORS_ALLOWED_ORIGINS=
