{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kesh",
  "version": "0.1.0",
  "identifier": "com.keshri.kesh",
  "build": {
    "beforeDevCommand": "cd ../kesh-frontend && npm run dev",
    "beforeBuildCommand": "cd ../kesh-frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../kesh-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kesh",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
